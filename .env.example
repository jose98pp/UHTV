APP_NAME="Ultima Hora TV"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ultimahora-tv.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Base de Datos
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bd_noti
DB_USERNAME=root
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Caché, Sesiones y Colas (Rendimiento de Producción)
# -----------------------------------------------------------------------------
# Opción A (Recomendada con Redis en VPS/Cloud):
# CACHE_STORE=redis
# CACHE_DRIVER=redis
# SESSION_DRIVER=redis
# QUEUE_CONNECTION=redis
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# Opción B (Hosting Compartido / File):
CACHE_STORE=file
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=database

FILESYSTEM_DISK=public

# -----------------------------------------------------------------------------
# Correo Electrónico
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@ultimahora-tv.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Optimización de Imágenes
# -----------------------------------------------------------------------------
IMAGE_AUTO_OPTIMIZE=true
IMAGE_QUALITY=85
IMAGE_BACKUP_ENABLED=true

# -----------------------------------------------------------------------------
# Control de Instalación de la Aplicación PWA
# -----------------------------------------------------------------------------
ENABLE_PWA_INSTALL=false
